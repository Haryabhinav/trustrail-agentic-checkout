RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MANDATE_MAX_SPEND_INR=5000
MANDATE_ALLOWED_CATEGORIES=electronics,groceries,office-supplies
DATABASE_URL=sqlite:///./paypilot.db

# Comma-separated list of frontend origins allowed to call this API. Restrict this to your
# real frontend URL(s) in any non-local deployment — a wildcard here lets any website's JS
# call money-moving endpoints from a merchant's own browser session (CSRF via fetch()).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# /demo/* endpoints can move real money or corrupt state with a single unauthenticated
# request — they exist only to make buildathon demo scenarios repeatable on cue. Set to
# false to not mount them at all outside of an active demo.
ENABLE_DEMO_ROUTES=true

# AP2 (Agent Payments Protocol) mock-signing secret and merchant identity — see app/ap2.py.
# Set a real random value for anything beyond local demo use; the config.py default is
# public (it's in this repo), so leaving it unset means anyone can forge a CartMandate
# signature against the default.
AP2_MOCK_SIGNING_SECRET=paypilot-demo-mock-signing-secret
UCP_MERCHANT_NAME=PayPilot Demo Store
